FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

# az acr build keeps no layer cache between builds, so there's no separate dependency
# layer — copy the build and sources, then build. settings.gradle auto-discovers themes/
# and os/agents/, so new agent modules need no edit here.
COPY gradle gradle
COPY gradlew .
COPY build.gradle .
COPY settings.gradle .
COPY themes themes

# genesis-os (os:app) depends on the os/ modules only, not genesis-brands
COPY shared-domain shared-domain
COPY os os
RUN ./gradlew :os:app:bootJar --no-daemon -q

# No Playwright/Chromium here — genesis-os has no brand-book PDF assembly, so a plain
# Alpine JRE (unlike genesis-brands' Ubuntu-jammy runtime) is enough.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

COPY --from=build /workspace/os/app/build/libs/os-app-0.0.1-SNAPSHOT.jar app.jar
COPY ingestion ingestion

# Install Python 3 + pip for the ingestion pipeline (Alpine syntax).
# --break-system-packages is required on Alpine's externally-managed Python.
RUN apk add --no-cache python3 py3-pip \
  && pip3 install --no-cache-dir --break-system-packages -r ingestion/requirements.txt

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
